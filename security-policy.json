{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "AllowJuniorAnalystReadOnly",
      "Effect": "Allow",
      "Action": [
        "s3:GetObject",
        "s3:ListBucket"
      ],
      "Resource": "arn:aws:s3:::company-public-reports/*"
    },
    {
      "Sid": "DenyUnencryptedUploadsAndDeletes",
      "Effect": "Deny",
      "Action": [
        "s3:DeleteObject",
        "s3:PutBucketPublicAccessBlock"
      ],
      "Resource": "*"
    },
    {
      "Sid": "BlockConfidentialFolderWithoutMFA",
      "Effect": "Deny",
      "Action": "s3:*",
      "Resource": "arn:aws:s3:::company-confidential-vault/*",
      "Condition": {
        "BoolIfExists": {
          "aws:MultiFactorAuthPresent": "false"
        }
      }
    }
  ]
}
